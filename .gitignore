# ---- 训练产物（下面单独放行论文使用的 QM9 权重）----
*.pth
*.pt
*.ckpt
*.safetensors
save_models/
save_models_toy/
checkpoints/
runs/
outputs/
bent_generated/
wandb/

# ---- 数据集（体积大且常有许可限制，README 里给下载脚本即可）----
# 注意用 data/* 而非 data/ ——父目录被整体排除时，下面的 !data/README.md 会失效
data/*
!data/README.md
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.pickle

# ---- 随仓库发布的固定 Bent 数据与 QM9 EMA 权重 ----
!data/bent/
!data/bent/two_gaussian_train_val_data.pt
!data/bent/two_gaussian_test_data.pt
!model/qm9_efdm_epoch8000_ema.pth

# ---- 集群 / 作业日志（含绝对路径与用户名）----
logs/
slurm-*.out
slurm-*.err
*.log

# ---- 评估产物（图、指标、采样结果）----
eval_outputs/
samples/
results/
figs/
*.pdf
*.png
*.jpg
!docs/**/*.png

# ---- Notebook 输出（可能残留路径、traceback、数据）----
.ipynb_checkpoints/

# ---- 密钥 / 凭据（保险起见，永远不要提交）----
.env
.env.*
*.key
*.pem
secrets.*
credentials.*
.netrc

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
__MACOSX/
